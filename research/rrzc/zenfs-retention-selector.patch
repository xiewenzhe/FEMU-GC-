+// 仅尝试占用单个Zone，不等待业务；Reset前点必须早于设备查询，避免拼接旧设备代际。
+static rrzc_retention::Frame ReadRetentionFrame(ZonedBlockDevice* device,
+    const rrzc_v1::RecentReport& report,const std::map<uint64_t,ZoneResetState>& before,
+    const rrzc_observe::MigrationWindow::Frame& marker,rrzc_observe::MigrationWindow* tracker) {
+  rrzc_retention::Frame frame;
+  frame.session_hi=report.session_hi; frame.session_lo=report.session_lo; frame.before=marker;
+  for (const auto& b:report.zones) {
+    Zone* zone=device->GetIOZone(b.zone);
+    if (!zone) continue;
+    rrzc_retention::Point p; p.zone=b.zone; p.device_generation=b.generation;
+    p.time=std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (zone->Acquire()) {
+      const auto first=before.find(b.zone); const auto reset=zone->GetResetState();
+      p.valid=zone->used_capacity_.load(); p.host_generation=reset.generation;
+      p.host_sequence=reset.sequence;
+      p.known=zone->IsFull() && first!=before.end() &&
+          IsMaintenanceWindowStable(first->second,reset,reset);
+      if (!zone->Release()) p.known=false;
+    }
+    frame.zones.emplace(p.zone,p);
+  }
+  frame.after=tracker->Freeze();
+  return frame;
+}
+
+static void LogRetentionFrame(const std::shared_ptr<Logger>& logger,
+    const rrzc_retention::Frame& frame,const char* stage,uint64_t round) {
+  for (const auto& item:frame.zones) {
+    const auto& p=item.second;
+    const auto a=frame.before.Get(p.zone),b=frame.after.Get(p.zone);
+    Info(logger,"留存原始采样：阶段=%s，轮次=%lu，会话=%lu/%lu，Zone=%lu，时点纳秒=%lu，有效字节=%lu，可知满区=%d，设备代际=%lu，主机代际=%lu，主机序号=%lu，迁移实例=%lu，迁移创建纳秒=%lu，迁移前纳秒=%lu，迁移后纳秒=%lu，迁移可信=%d，迁移序号=%lu/%lu，迁移活动=%lu/%lu，迁移末次结束=%lu/%lu",
+         stage,round,frame.session_hi,frame.session_lo,p.zone,p.time,p.valid,p.known,
+         p.device_generation,p.host_generation,p.host_sequence,frame.before.owner,
+         frame.before.created_ns,frame.before.captured_ns,frame.after.captured_ns,
+         frame.before.reliable && frame.after.reliable && frame.before.owner==frame.after.owner,
+         a.sequence,b.sequence,a.active,b.active,a.last_end_ns,b.last_end_ns);
+  }
+}
