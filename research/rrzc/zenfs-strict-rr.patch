 IOStatus ZoneFile::PositionedRead(uint64_t offset, size_t n, Slice* result,
                                   char* scratch, bool direct) {
+  auto strict_lock=zbd_->StrictLock();
+  for(unsigned retry=0;retry<32;++retry) {
+    rrzc_strict::reached=false;
+    const auto status=PositionedReadOnce(offset,n,result,scratch,direct);
+    if(!zbd_->StrictRR() || !rrzc_strict::reached) return status;
+    // Once已销毁ReadLock；迁移更新映射不会等待当前读取自身。
+    const auto refresh=zbd_->ServiceStrictRR();
+    if(!refresh.ok()) return refresh;
+  }
+  return IOStatus::IOError("严格RR读取重试超过上限，停止而非越过阈值");
+}
