 int ZbdlibBackend::Read(char *buf, int size, uint64_t pos, bool direct) {
+  const char* strict=getenv("ZENFS_RR_STRICT");
+  if(strict && !strcmp(strict,"1")) {
+    if(size<=0) return size;
+    const int nsid=ioctl(read_f_,NVME_IOCTL_ID);
+    if(nsid<=0) {errno=ENOTSUP;return -1;}
+    alignas(4096) char page[4096];
+    int done=0;
+    while(done<size) {
+      const uint64_t current=pos+done;
+      const uint64_t aligned=current & ~uint64_t(4095);
+      nvme_passthru_cmd cmd={};
+      cmd.opcode=0xc2;cmd.nsid=nsid;
+      cmd.addr=reinterpret_cast<uint64_t>(page);cmd.data_len=sizeof(page);
+      const uint64_t lba=aligned/512;
+      cmd.cdw10=uint32_t(lba);cmd.cdw11=uint32_t(lba>>32);cmd.cdw12=7;
+      cmd.cdw13=0x52520000u | unsigned(rrzc_strict::migration);
+      const int status=ioctl(read_f_,NVME_IOCTL_IO_CMD,&cmd);
+      if(status<0)return -1;
+      if(status) {
+        if((status & 0x7ff)==0x7f0) {rrzc_strict::reached=true;errno=EAGAIN;}
+        else errno=EIO;
+        return -1;
+      }
+      // 达阈值的本页真实读取已计数；普通读取在锁外维护后按新映射重试。
+      if(cmd.result && !rrzc_strict::migration) {
+        rrzc_strict::reached=true;errno=EAGAIN;return -1;
+      }
+      const int take=std::min<int>(size-done,4096-(current-aligned));
+      memcpy(buf+done,page+(current-aligned),take);done+=take;
+    }
+    return done;
+  }
   return pread(direct ? read_direct_f_ : read_f_, buf, size, pos);
 }
 
