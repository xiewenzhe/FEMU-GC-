 namespace ROCKSDB_NAMESPACE {
 
+namespace {
+
+constexpr uint8_t kFemuReadPressureLog = 0xc1;
+
+struct __attribute__((packed)) ReadPressureLogHeader {
+  uint32_t version;
+  uint32_t entry_size;
+  uint32_t nr_zones;
+  uint32_t blocks_per_zone;
+  uint64_t read_threshold;
+  uint64_t reserved;
+};
+
+struct __attribute__((packed)) ReadPressureLogEntry {
+  uint64_t zslba;
+  uint64_t max_block_reads;
+  uint64_t sum_block_reads;
+  uint32_t blocks_ge_80pct;
+  uint32_t blocks_ge_90pct;
+  uint32_t blocks_at_threshold;
+  uint32_t reserved;
+};
+
+static_assert(sizeof(ReadPressureLogHeader) == 32, "C1h 日志头长度异常");
+static_assert(sizeof(ReadPressureLogEntry) == 40, "C1h 日志条目长度异常");
+
+IOStatus ReadPressureLog(int fd, uint32_t nsid, void *data, uint32_t len) {
+  nvme_admin_cmd cmd = {};
+  uint32_t dwords = len / 4 - 1;
+  cmd.opcode = 0x02;  // 获取日志页
+  cmd.nsid = nsid;
+  cmd.addr = reinterpret_cast<uint64_t>(data);
+  cmd.data_len = len;
+  cmd.cdw10 = ((dwords & 0xffff) << 16) | kFemuReadPressureLog;
+  cmd.cdw11 = dwords >> 16;
+
+  int ret = ioctl(fd, NVME_IOCTL_ADMIN_CMD, &cmd);
+  if (ret < 0) {
+    return IOStatus::IOError("读取 FEMU 物理块读取压力日志失败：" +
+                             std::string(strerror(errno)));
+  }
+  if (ret != 0) {
+    return IOStatus::IOError("读取 FEMU 物理块读取压力日志的 NVMe 状态码：" +
+                             std::to_string(ret));
+  }
+  return IOStatus::OK();
+}
