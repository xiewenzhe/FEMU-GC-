 namespace ROCKSDB_NAMESPACE {
 
+// 只检查本进程 Reset 在观测窗口内是否变化，不保证文件映射或读数是原子快照。
+static bool IsMaintenanceWindowStable(const ZoneResetState& before,
+                                      const ZoneResetState& after,
+                                      const ZoneResetState& current) {
+  return before.stable && after.stable && current.stable &&
+         before.known && after.known && current.known &&
+         before.sequence == after.sequence && after.sequence == current.sequence &&
+         before.generation == after.generation && after.generation == current.generation;
+}
+
+static void LogMaintenanceObservation(
+    const std::shared_ptr<Logger>& logger, ZonedBlockDevice* device,
+    const char* stage, const ZoneSnapshot& zone, const ZoneReadPressure* pressure,
+    uint64_t covered, bool non_sst,
+    const std::map<uint64_t, ZoneResetState>& before,
+    const std::map<uint64_t, ZoneResetState>& after) {
+  if (!device->IsMaintenanceDiagnosticsEnabled()) return;
+  auto first = before.find(zone.start);
+  auto last = after.find(zone.start);
+  Zone* live = device->GetIOZone(zone.start);
+  if (first == before.end() || last == after.end() || live == nullptr) return;
+  const auto current = live->GetResetState();
+  const bool covered_all = covered == zone.used_capacity;
+  const bool eligible = zone.used_capacity > 0 && zone.wp != zone.start &&
+                        covered_all && !non_sst;
+  Info(logger, "Zone 维护观测：阶段=%s，Zone=%lu，主机代际=%lu/%lu/%lu，观察序号=%lu/%lu/%lu，重置窗稳定=%d，快照写指针=%lu，满区=%d，有效字节=%lu，覆盖字节=%lu，含非SST=%d，覆盖完整=%d，SST覆盖资格=%d，读压力可用=%d，达阈值块=%u，迁移准入=未检查",
+       stage, zone.start, first->second.generation, last->second.generation,
+       current.generation, first->second.sequence, last->second.sequence,
+       current.sequence, IsMaintenanceWindowStable(first->second, last->second, current),
+       zone.wp, zone.capacity == 0, zone.used_capacity, covered, non_sst,
+       covered_all, eligible, pressure != nullptr,
+       pressure != nullptr ? pressure->blocks_at_threshold : 0);
+}
