+std::map<uint64_t, ZoneResetState> ZonedBlockDevice::GetZoneResetStates() const {
+  std::map<uint64_t, ZoneResetState> states;
+  for (const auto* zone : io_zones) states.emplace(zone->start_, zone->GetResetState());
+  for (const auto* zone : meta_zones) states.emplace(zone->start_, zone->GetResetState());
+  return states;
+}
+
+void ZonedBlockDevice::LogZoneReset(const ZoneResetState& state,
+                                    uint64_t previous_generation,
+                                    uint64_t old_wp, const IOStatus& status,
+                                    bool offline) {
+  if (!maintenance_diag_enabled_) return;
+  Info(logger_, "Zone 重置诊断：Zone=%lu，状态=%s，主机代际=%lu/%lu，观察序号=%lu，代际可信=%d，原写指针=%lu，离线=%d，结果=%s",
+       state.start, status.ok() ? "成功" : "失败", previous_generation,
+       state.generation, state.sequence, state.known, old_wp,
+       status.ok() ? static_cast<int>(offline) : -1, status.ToString().c_str());
+}
