+ZoneResetState Zone::GetResetState() const {
+  const uint64_t before = reset_sequence_.load();
+  ZoneResetState state;
+  state.start = start_;
+  state.generation = reset_generation_.load();
+  state.known = reset_generation_known_.load();
+  state.sequence = reset_sequence_.load();
+  state.stable = before == state.sequence && state.sequence % 2 == 0;
+  return state;
+}
