+IOStatus ZenFS::ReadReclaimOneZone() {
+  ZoneReadPressureReport pressure;
+  IOStatus s = zbd_->GetZoneReadPressure(&pressure);
+  if (!s.ok()) return s;
+  if (pressure.read_threshold == 0) return IOStatus::OK();
+
+  ZenFSSnapshot snapshot;
+  ZenFSSnapshotOptions options;
+  options.zone_ = 1;
+  options.zone_file_ = 1;
+  GetZenFSSnapshot(snapshot, options);
+
+  std::map<uint64_t, uint64_t> covered_bytes;
+  std::set<uint64_t> non_sst_zones;
+  for (const auto& ext : snapshot.extents_) {
+    covered_bytes[ext.zone_start] += ext.length;
+    if (ext.filename.size() < 4 ||
+        ext.filename.compare(ext.filename.size() - 4, 4, ".sst") != 0) {
+      non_sst_zones.emplace(ext.zone_start);
+    }
+  }
+
+  for (const auto& zone_pressure : pressure.zones) {
+    if (zone_pressure.blocks_at_threshold == 0) continue;
+    Zone* io_zone = zbd_->GetIOZone(zone_pressure.start);
+    if (io_zone == nullptr) continue;
+
+    auto zone_it = std::find_if(snapshot.zones_.begin(), snapshot.zones_.end(),
+                                [&](const ZoneSnapshot& zone) {
+                                  return zone.start == zone_pressure.start;
+                                });
+    if (zone_it == snapshot.zones_.end() || zone_it->used_capacity == 0 ||
+        zone_it->wp == zone_it->start) {
+      continue;
+    }
+
+    // 快照未覆盖所有有效数据时，不允许对该 Zone 执行 RR 迁移。
+    if (covered_bytes[zone_it->start] != zone_it->used_capacity ||
+        non_sst_zones.count(zone_it->start) != 0) {
+      Info(logger_, "RR 延后：Zone %lu 含未覆盖或非 SST 的有效数据",
+           zone_it->start);
+      continue;
+    }
+
+    std::vector<ZoneExtentSnapshot*> migrate_exts;
+    for (auto& ext : snapshot.extents_) {
+      if (ext.zone_start == zone_it->start) migrate_exts.push_back(&ext);
+    }
+    if (migrate_exts.empty()) continue;
+
+    // 先独占并封闭源 Zone，避免新写入使快照失效。
+    if (!io_zone->Acquire()) continue;
+    if (io_zone->used_capacity_ != zone_it->used_capacity ||
+        io_zone->wp_ != zone_it->wp) {
+      if (!io_zone->Release()) {
+        return IOStatus::Corruption("RR 源 Zone 的占用标志释放失败");
+      }
+      continue;
+    }
+    bool was_full = io_zone->IsFull();
+    uint64_t sacrificed_bytes = was_full ? 0 : io_zone->capacity_;
+    s = was_full ? IOStatus::OK() : io_zone->Finish();
+    bool released = io_zone->Release();
+    if (s.ok() && !was_full) zbd_->PutActiveIOZoneToken();
+    if (!s.ok()) return s;
+    if (!released) {
+      return IOStatus::Corruption("RR 源 Zone 的占用标志释放失败");
+    }
+
+    Info(logger_, "RR 开始：Zone %lu，达阈值物理块 %u，有效数据 %lu 字节，封闭剩余容量 %lu 字节",
+         zone_it->start, zone_pressure.blocks_at_threshold,
+         zone_it->used_capacity, sacrificed_bytes);
+    MigrationStats stats;
+    ++rr_attempts_;
+    s = MigrateExtents(migrate_exts, &stats);
+    rr_migrated_bytes_ += stats.migrated_bytes;
+    Info(logger_, "RR 统计：尝试 %lu 次，本次迁移 %lu 字节，本次重置 %lu 个 Zone，累计迁移 %lu 字节",
+         rr_attempts_, stats.migrated_bytes, stats.reset_zones,
+         rr_migrated_bytes_);
+    if (!s.ok()) return s;
+    if (io_zone->IsEmpty()) {
+      ++rr_completed_zones_;
+      Info(logger_, "RR 完成：Zone %lu 已重置，累计完成 %lu 次",
+           zone_it->start, rr_completed_zones_);
+    } else {
+      Info(logger_, "RR 未完成：Zone %lu 尚有有效数据，未重置",
+           zone_it->start);
+    }
+    return IOStatus::OK();
+  }
+
+  return IOStatus::OK();
+}
