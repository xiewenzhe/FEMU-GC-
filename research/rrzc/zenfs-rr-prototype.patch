+IOStatus ZbdlibBackend::GetZoneReadPressure(ZoneReadPressureReport *report) {
+  int nsid = ioctl(read_f_, NVME_IOCTL_ID);
+  if (nsid <= 0) {
+    return IOStatus::NotSupported("读取压力接口要求使用 NVMe 命名空间");
+  }
+
+  ReadPressureLogHeader header = {};
+  IOStatus s = ReadPressureLog(read_f_, nsid, &header, sizeof(header));
+  if (!s.ok()) return s;
+  if (le32toh(header.version) != 1 ||
+      le32toh(header.entry_size) != sizeof(ReadPressureLogEntry) ||
+      le32toh(header.nr_zones) != nr_zones_) {
+    return IOStatus::Corruption("FEMU 读取压力日志格式异常");
+  }
+
+  std::vector<uint8_t> bytes(sizeof(header) +
+                             nr_zones_ * sizeof(ReadPressureLogEntry));
+  s = ReadPressureLog(read_f_, nsid, bytes.data(), bytes.size());
+  if (!s.ok()) return s;
+
+  const auto *full_header =
+      reinterpret_cast<const ReadPressureLogHeader *>(bytes.data());
+  if (le32toh(full_header->version) != 1 ||
+      le32toh(full_header->entry_size) != sizeof(ReadPressureLogEntry) ||
+      le32toh(full_header->nr_zones) != nr_zones_) {
+    return IOStatus::Corruption("读取期间 FEMU 读取压力日志格式发生变化");
+  }
+
+  ZoneReadPressureReport result;
+  result.read_threshold = le64toh(full_header->read_threshold);
+  result.blocks_per_zone = le32toh(full_header->blocks_per_zone);
+  const auto *entries = reinterpret_cast<const ReadPressureLogEntry *>(
+      bytes.data() + sizeof(ReadPressureLogHeader));
+  result.zones.reserve(nr_zones_);
+  for (uint32_t i = 0; i < nr_zones_; ++i) {
+    const auto &entry = entries[i];
+    ZoneReadPressure zone;
+    // C1h 条目按命名空间内的 Zone 顺序排列；zone_sz_ 的单位是字节。
+    zone.start = static_cast<uint64_t>(i) * zone_sz_;
+    zone.max_block_reads = le64toh(entry.max_block_reads);
+    zone.sum_block_reads = le64toh(entry.sum_block_reads);
+    zone.blocks_ge_80pct = le32toh(entry.blocks_ge_80pct);
+    zone.blocks_ge_90pct = le32toh(entry.blocks_ge_90pct);
+    zone.blocks_at_threshold = le32toh(entry.blocks_at_threshold);
+    if (i == 0 && le64toh(entry.zslba) != 0) {
+      return IOStatus::Corruption("FEMU 读取压力日志中的首个 Zone 异常");
+    }
+    result.zones.emplace_back(zone);
+  }
+
+  *report = std::move(result);
+  return IOStatus::OK();
+}
