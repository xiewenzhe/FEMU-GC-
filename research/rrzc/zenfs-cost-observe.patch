+std::vector<rrzc_cost::ValidityPoint> ZonedBlockDevice::GetCostValidityReadings(
+    const rrzc_v1::RecentReport& report, uint64_t time_ns) const {
+  std::vector<rrzc_cost::ValidityPoint> out;
+  for (const auto* zone:io_zones) {
+    const auto before=zone->GetResetState();
+    const uint64_t valid=zone->used_capacity_.load();
+    const auto after=zone->GetResetState();
+    const auto b=std::find_if(report.zones.begin(),report.zones.end(),
+        [&](const rrzc_v1::RecentBlock& x){return x.zone==zone->start_;});
+    rrzc_cost::ValidityPoint p;
+    p.zone=zone->start_; p.time_ns=time_ns; p.valid=valid;
+    p.host_generation=after.generation; p.host_sequence=after.sequence;
+    if (b!=report.zones.end()) p.device_generation=b->generation;
+    p.known=b!=report.zones.end() && before.stable && after.stable &&
+        before.known && after.known && before.generation==after.generation &&
+        before.sequence==after.sequence;
+    out.push_back(p);
+  }
+  return out;
+}
+
+rrzc_cost::ReserveObservation ZonedBlockDevice::GetMigrationReserveObservation() {
+  rrzc_cost::ReserveObservation out;
+  out.enabled=migration_reserve_enabled_;
+  if (!out.enabled) return out;
+  // 只尝试已有管理锁；不等待迁移、不Acquire任何Zone，也不补充预留。
+  std::unique_lock<std::mutex> migrate_lock(migrate_zone_mtx_,std::try_to_lock);
+  if (!migrate_lock.owns_lock() || migrating_) { out.reason="迁移管理忙，尾部未知"; return out; }
+  std::unique_lock<std::mutex> reserve_lock(migration_reserve_mtx_,std::try_to_lock);
+  if (!reserve_lock.owns_lock()) { out.reason="预留管理忙，尾部未知"; return out; }
+  Zone* zone=migration_reserve_zone_;
+  out.known=true; out.present=zone!=nullptr;
+  if (zone==nullptr) { out.reason="当前没有专用预留，不推断无其他目标"; return out; }
+  const auto before=zone->GetResetState();
+  out.zone=zone->start_; out.remaining=zone->capacity_; out.wp=zone->wp_;
+  out.valid=zone->used_capacity_.load();
+  const auto after=zone->GetResetState();
+  out.host_generation=after.generation; out.host_sequence=after.sequence;
+  out.known=before.stable && after.stable && before.known && after.known &&
+      before.generation==after.generation && before.sequence==after.sequence;
+  out.reason=out.known ? "当前专用预留快照，不代表最终迁移目标" : "预留Reset观察变化";
+  return out;
+}
