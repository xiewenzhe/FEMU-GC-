+static rrzc_cost::ValidityFrame ReadCostFrame(ZonedBlockDevice* device,
+                                             const rrzc_v1::RecentReport& report) {
+  rrzc_cost::ValidityFrame frame;
+  frame.session_hi=report.session_hi; frame.session_lo=report.session_lo;
+  const uint64_t now=std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  frame.zones=device->GetCostValidityReadings(report,now);
+  return frame;
+}
