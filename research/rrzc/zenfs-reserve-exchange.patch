+IOStatus ZonedBlockDevice::ExchangeMigrationReserve(uint64_t required) {
+  if (!migration_reserve_enabled_ || !required) return IOStatus::OK();
+  // 锁顺序与现有迁移分配相同；不等待在途迁移或占用中的普通部分区。
+  std::unique_lock<std::mutex> migrate_lock(migrate_zone_mtx_,std::try_to_lock);
+  if (!migrate_lock.owns_lock() || migrating_) return IOStatus::OK();
+  std::unique_lock<std::mutex> reserve_lock(migration_reserve_mtx_,std::try_to_lock);
+  if (!reserve_lock.owns_lock()) return IOStatus::OK();
+  Zone* old=migration_reserve_zone_;
+  if (!old || old->capacity_>=required || old->IsEmpty() || old->IsFull()) return IOStatus::OK();
+  const rrzc_exchange::State previous{old->start_,old->capacity_,old->max_capacity_,
+      old->used_capacity_.load(),old->wp_};
+  Zone* next=nullptr;
+  for (auto* zone:io_zones) {
+    if (zone==old || !zone->Acquire()) continue;
+    const rrzc_exchange::State current{zone->start_,zone->capacity_,zone->max_capacity_,
+        zone->used_capacity_.load(),zone->wp_};
+    if (rrzc_exchange::CanExchange(required,previous,current) &&
+        (!next || zone->capacity_>next->capacity_)) {
+      if (next) {
+        const auto release=next->CheckRelease();
+        if (!release.ok()) { zone->CheckRelease(); return release; }
+      }
+      next=zone;
+    } else {
+      const auto release=zone->CheckRelease();
+      if (!release.ok()) {
+        if (next) next->CheckRelease();
+        return release;
+      }
+    }
+  }
+  if (!next) return IOStatus::OK();
+  const auto closed=old->Close();
+  if (!closed.ok()) { next->CheckRelease(); return closed; }
+  // 两者均为非空且未满的活跃部分区。新预留原有的一个普通活跃令牌转给
+  // 旧预留，因此总令牌计数不增减；新预留保留Acquire，旧预留释放给普通池。
+  migration_reserve_zone_=next;
+  const auto released=old->CheckRelease();
+  if (!released.ok()) return released;
+  Info(logger_,"公共预留归属交换：需要字节=%lu，旧Zone=%lu，旧剩余字节=%lu，旧有效字节=%lu，新Zone=%lu，新剩余字节=%lu，新有效字节=%lu，不复制=1，不Finish=1，不Reset=1，普通活跃令牌转移=1",
+       required,previous.zone,previous.remaining,previous.valid,next->start_,
+       next->capacity_,next->used_capacity_.load());
+  return IOStatus::OK();
+}
