+IOStatus ZbdlibBackend::GetZoneRecentReads(rrzc_v1::RecentReport *report) {
+  *report = {};
+  if (!nr_zones_ || nr_zones_ > (UINT32_MAX-rrzc_v1::kHeaderBytes)/rrzc_v1::kEntryBytes)
+    return IOStatus::InvalidArgument("C2h区数量或长度不合法");
+  int nsid = ioctl(read_f_, NVME_IOCTL_ID);
+  if (nsid <= 0) return IOStatus::NotSupported("C2h要求NVMe命名空间");
+  // 已知设备区数，单次读取完整页；不能先查头再查条目拼成跨时刻快照。
+  std::vector<uint8_t> bytes(rrzc_v1::kHeaderBytes+size_t(nr_zones_)*rrzc_v1::kEntryBytes);
+  nvme_admin_cmd cmd = {};
+  const uint32_t dwords = uint32_t(bytes.size()/4-1);
+  cmd.opcode=0x02; cmd.nsid=nsid;
+  cmd.addr=reinterpret_cast<uint64_t>(bytes.data()); cmd.data_len=bytes.size();
+  cmd.cdw10=((dwords & 0xffff)<<16)|0xc2; cmd.cdw11=dwords>>16;
+  const int ret=ioctl(read_f_,NVME_IOCTL_ADMIN_CMD,&cmd);
+  if (ret < 0) return IOStatus::IOError("读取C2h失败："+std::string(strerror(errno)));
+  if (ret) return IOStatus::IOError("读取C2h的NVMe状态码："+std::to_string(ret));
+  std::string error;
+  if (!rrzc_v1::DecodeRecent(bytes.data(),bytes.size(),nr_zones_,zone_sz_,report,&error))
+    return IOStatus::Corruption(error);
+  return IOStatus::OK();
+}
