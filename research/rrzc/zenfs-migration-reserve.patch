+// 调用者须持有 migration_reserve_mtx_；空区只锁定，不提前写入或擦除。
+IOStatus ZonedBlockDevice::EnsureMigrationReserve() {
+  if (migration_reserve_zone_ != nullptr) return IOStatus::OK();
+  for (auto *zone : io_zones) {
+    if (!zone->Acquire()) continue;
+    if (zone->IsEmpty()) {
+      migration_reserve_zone_ = zone;
+      Info(logger_, "迁移预留取得空区：Zone=%lu", zone->start_);
+      return IOStatus::OK();
+    }
+    auto s = zone->CheckRelease();
+    if (!s.ok()) return s;
+  }
+  // 无空区时保持空指针，等待后续回收补充，不凭空保证迁移必定成功。
+  return IOStatus::OK();
+}
