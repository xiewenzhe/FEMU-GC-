+IOStatus ZonedBlockDevice::PrepareReadReclaimSource(
+    Zone *zone, uint64_t expected_used, uint64_t expected_wp, bool *prepared,
+    uint64_t *sacrificed_bytes) {
+  *prepared = false;
+  *sacrificed_bytes = 0;
+  // 锁顺序与迁移目标管理一致；不等待正在进行的迁移，留待下一轮 RR。
+  std::lock_guard<std::mutex> migrate_lock(migrate_zone_mtx_);
+  if (migrating_) return IOStatus::OK();
+  std::lock_guard<std::mutex> reserve_lock(migration_reserve_mtx_);
+  const bool reserved = zone == migration_reserve_zone_;
+  if (!reserved && !zone->Acquire()) return IOStatus::OK();
+  if (expected_used == 0 || zone->IsEmpty() ||
+      zone->used_capacity_ != expected_used || zone->wp_ != expected_wp) {
+    // 专用区的独占权属于预留池，快照失效时必须保留，不能释放给普通写入。
+    return reserved ? IOStatus::OK() : zone->CheckRelease();
+  }
+
+  const bool was_full = zone->IsFull();
+  const uint64_t remaining = was_full ? 0 : zone->capacity_;
+  auto s = was_full ? IOStatus::OK() : zone->Finish();
+  if (!s.ok()) {
+    if (!reserved) {
+      auto release_status = zone->CheckRelease();
+      if (!release_status.ok()) return release_status;
+    }
+    return s;
+  }
+  if (!reserved && !was_full) PutActiveIOZoneToken();
+  if (reserved) migration_reserve_zone_ = nullptr;
+  s = zone->CheckRelease();
+  if (!s.ok()) return s;
+  *sacrificed_bytes = remaining;
+  if (reserved) {
+    Info(logger_, "RR 封闭专用预留源：Zone=%lu，封闭剩余=%lu 字节，不归还普通活跃令牌",
+         zone->start_, remaining);
+    s = EnsureMigrationReserve();
+    if (!s.ok()) return s;
+  }
+  *prepared = true;
+  return IOStatus::OK();
+}
