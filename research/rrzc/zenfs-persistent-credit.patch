 #include "rrzc_window_credit_selector.h"
+#include "rrzc_persistent_credit_selector.h"
@@ -536,0 +538,8 @@
+  const bool persistent_requested=getenv("ZENFS_RRZC_PERSISTENT_CREDIT") &&
+      !strcmp(getenv("ZENFS_RRZC_PERSISTENT_CREDIT"),"1");
+  const bool persistent_credit=persistent_requested && window_credit;
+  if(persistent_requested) {
+    Info(logger_,"持续读收益配置：请求=1，启用=%d，版本=1，短间隔最小=%lu，短间隔最大=%lu，原窗口留存不变=1，先选Greedy=0",
+        persistent_credit,rrzc_v1::kGrowthMinNs,rrzc_v1::kGrowthMaxNs);
+    if(!persistent_credit) Error(logger_,"持续读收益配置冲突：须独立启用窗口模型，不能混用其他执行分支");
+  }
