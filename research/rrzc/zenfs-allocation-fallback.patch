@@ -867,6 +873,54 @@
         new_zone = true;
       } else {
         PutActiveIOZoneToken();
+        if (allocation_fallback_enabled_ && io_type != IOType::kWAL) {
+          // 不持有 Zone 独占权或额外活跃令牌等待，让写入和 GC 能继续推进。
+          // 最多重试 200 次，间隔 50 毫秒；超时仍沿用原来的分配失败路径。
+          for (unsigned int attempt = 0; attempt < 200; ++attempt) {
+            if (GetActiveIOZoneTokenIfAvailable()) {
+              s = AllocateEmptyZone(&allocated_zone);
+              if (!s.ok() || allocated_zone == nullptr) {
+                PutActiveIOZoneToken();
+              }
+              if (!s.ok()) {
+                PutOpenIOZoneToken();
+                return s;
+              }
+              if (allocated_zone != nullptr) {
+                allocated_zone->lifetime_ = file_lifetime;
+                new_zone = true;
+                Info(logger_, "分配回退成功：重试=%u，新空Zone=%lu",
+                     attempt + 1, allocated_zone->start_);
+                break;
+              }
+            }
+
+            // 部分区使用已有活跃令牌；不放宽寿命差到 100。
+            unsigned int fallback_diff = LIFETIME_DIFF_NOT_GOOD;
+            s = GetBestOpenZoneMatch(file_lifetime, &fallback_diff,
+                                    &allocated_zone);
+            if (!s.ok()) {
+              PutOpenIOZoneToken();
+              return s;
+            }
+            if (allocated_zone != nullptr &&
+                fallback_diff > LIFETIME_DIFF_COULD_BE_WORSE) {
+              s = allocated_zone->CheckRelease();
+              allocated_zone = nullptr;
+              if (!s.ok()) {
+                PutOpenIOZoneToken();
+                return s;
+              }
+            }
+            if (allocated_zone != nullptr) {
+              Info(logger_, "分配回退成功：重试=%u，文件寿命=%d，匹配差=%u，Zone=%lu，剩余=%lu 字节",
+                   attempt + 1, static_cast<int>(file_lifetime), fallback_diff,
+                   allocated_zone->start_, allocated_zone->capacity_);
+              break;
+            }
+            if (attempt + 1 < 200) usleep(50 * 1000);
+          }
+        }
       }
     }
   }
