   if (allocation_diag_enabled_) {
     Info(logger_, "开启 Zone 分配诊断：复用原有扫描，占用中的 Zone 记为未观察");
   }
+  const char *fallback_env = getenv("ZENFS_ALLOC_FALLBACK");
+  allocation_fallback_enabled_ =
